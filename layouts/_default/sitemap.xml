{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- /* Only submit real pages. Hugo kinds: keep page/home/section; "term" (tag/category archives) and "taxonomy" (list pages) are excluded, as are hidden drafts. */ -}}
{{- range .Data.Pages }}
{{- $kind := printf "%s" .Kind }}
{{- if or (eq $kind "page") (eq $kind "home") (eq $kind "section") }}
{{- if not .Params.hidden }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05+00:00" }}</lastmod>{{ end }}{{ if .ExpiryDate }}
    <expires>{{ .ExpiryDate.Format "2006-01-02" }}</expires>{{ end }}
  </url>
{{- end }}
{{- end }}
{{- end }}
</urlset>
